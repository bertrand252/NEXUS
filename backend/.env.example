# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Groq (LLM) — single var so swapping model = 1 line change
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b

# Telegram Bot — dapetin dari @BotFather setelah /newbot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Channel Telegram yang bot-nya udah di-invite jadi admin (chat_id numerik,
# pisah koma). Kosong = fitur ini skip diem-diem.
TELEGRAM_CHANNEL_IDS=

# Channel Telegram yang cuma di-subscribe biasa (bukan channel sendiri, gak bisa
# jadiin bot admin) — di-scrape dari preview publik t.me/s/<username>. Isi
# username-nya doang (tanpa @), pisah koma.
TELEGRAM_SCRAPE_CHANNELS=

# Buat caller mesin-ke-mesin (WhatsApp listener, dst) yang gak bisa login penuh
SERVICE_API_KEY=

# Invezgo (opsional) — kosongin kalau belum subscribe, NEXUS fallback ke yfinance/mock.
# Generate di https://invezgo.com/id/setting/api
INVEZGO_API_KEY=

# CORS — Vercel frontend URL(s), comma-separated
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
